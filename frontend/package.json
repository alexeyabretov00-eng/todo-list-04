{
  "name": "todo-list-frontend",
  "version": "1.0.0",
  "description": "Hierarchical Todo List React SPA",
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack serve --mode development",
    "test": "jest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test:clear": "jest --clearCache",
    "test:changes": "jest --onlyChanged",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:onFirstFail": "jest --bail",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:versions": "node -e \"const p=require('./package.json'); const bad=[...Object.values(p.dependencies||{}),...Object.values(p.devDependencies||{})].filter(v=>v.startsWith('^')||v.startsWith('~')); if(bad.length){console.error('Version prefix found:',bad);process.exit(1);}console.log('All versions pinned exactly.');\""
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@reduxjs/toolkit": "2.11.2",
    "antd": "6.3.0",
    "dotenv": "17.3.1",
    "idb": "8.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "react-redux": "9.2.0",
    "styled-components": "6.3.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@storybook/builder-webpack5": "10.2.10",
    "@storybook/react": "10.2.10",
    "@storybook/react-webpack5": "10.2.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/styled-components": "5.1.36",
    "@types/webpack-env": "1.18.8",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "html-webpack-plugin": "5.6.6",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "prettier": "3.8.1",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "typescript-plugin-styled-components": "3.0.0",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3"
  }
}
